# HBM Demo 环境变量示例 — PLAN2 F6-3
# 复制到本目录 .env 或 agent_world/demo/.env 后填入真实 Key：
#   cp agent_world/hbm_demo/.env.example agent_world/hbm_demo/.env

# LLM API Key（Runner Agent + Flask 打分 / immediate_msg，必填方可完整游玩 Turn 1+）
DMXAPI_KEY=sk-your-key-here

# ---- 可选 ----
# HBM_SIM_DIR=agent_world/hbm_demo/sim/hbm_memory_war/
# HBM_IPC_TIMEOUT=600
# FLASK_RUN_PORT=5050
# VITE_PORT=5173
